# Frontend build configuration (Vite inlines VITE_-prefixed vars at build time).
# Copy to `.env` for local dev, and set these as build variables on Railway.
# These are the PUBLISHABLE (anon) values — safe to expose in the browser bundle.
# Never put the Supabase service-role key here; it lives only in Edge Function env.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Canonical public app URL used in share/invite links (certificates, Dashboard).
# Local: http://localhost:5173
# Production: https://mvp.the1campaign.com (or your Railway domain)
VITE_PUBLIC_APP_URL=http://localhost:5173

# For the local production-simulation stack (`supabase start`), point these at the
# local stack instead, e.g.:
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_PUBLISHABLE_KEY=<anon key printed by `supabase start`>

# Emission Calculator service (flight CO₂). Placeholder localhost URL; the real
# domain:port is set as a Railway build variable at deploy time. When unset or
# unreachable, the calculators transparently fall back to the local formula.
VITE_EMISSION_API_URL=http://localhost:5001
# X-API-Key for the service's compute endpoint. Leave empty locally (the service
# runs with API_KEY unset = auth off in dev). NOTE: VITE_ vars ship in the browser
# bundle, so a production value here would be public — proxy via an Edge Function
# if that key must stay secret.
VITE_EMISSION_API_KEY=
