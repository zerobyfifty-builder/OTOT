# Frontend build configuration (Vite inlines VITE_-prefixed vars at build time).
# Copy to `.env` for local dev.

# Canonical public app URL used in share links.
# Local: http://localhost:5173
VITE_PUBLIC_APP_URL=http://localhost:5173

# OTOT API (JWT login / signup /me). Vite inlines this at build time.
# Local API: http://localhost:4000
# Railway staging (use this if the local API is not running):
VITE_API_URL=https://apistaging.onetouristonetree.com

# Portal selection is derived from the hostname at runtime:
#   www./apex → tourist   office. → ministry   partner. → vendor
# Locally every portal is reachable after demo login.
# Optionally pin a portal: VITE_FORCE_PORTAL=tourist
# Or use ?portal=ministry / ?portal=vendor on localhost.

# Emission Calculator service (flight CO₂). When unset or unreachable,
# the calculator falls back to the local Haversine formula.
VITE_EMISSION_API_URL=http://localhost:5001
# X-API-Key for the service. Leave empty locally (auth off in dev).
VITE_EMISSION_API_KEY=
